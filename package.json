{
  "name": "goodchords-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "build": "nx run-many -t build --projects=goodchords,fretboard",
    "lint": "nx run-many -t lint --projects=goodchords,fretboard",
    "lint:fix": "nx run-many -t lint --projects=goodchords,fretboard --fix",
    "test": "nx run-many -t test --projects=goodchords,fretboard",
    "test:watch": "nx test goodchords --watch",
    "test:coverage": "nx run-many -t test --projects=goodchords,fretboard --coverage",
    "typecheck": "nx run-many -t typecheck --projects=goodchords,fretboard",
    "start": "nx serve fretboard"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@nx/angular": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/rollup": "23.0.1",
    "@nx/vitest": "23.0.1",
    "@nx/web": "23.0.1",
    "@schematics/angular": "~21.2.0",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "^4.0.0",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.39.0",
    "husky": "^8.0.3",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.3.0",
    "nx": "23.0.1",
    "prettier": "~3.6.2",
    "rollup": "^4.61.0",
    "tslib": "^2.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "goodchords": "0.5.0",
    "rxjs": "~7.8.0"
  }
}
